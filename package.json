{
  "name": "@glimpsegate/admission-lab",
  "version": "2.5.0",
  "codename": "Feedback Language",
  "releaseDate": "2026-09-26",
  "private": true,
  "type": "module",
  "description": "Choice-gated knowledge admission protocol for deciding how AI-generated claims may enter memory.",
  "main": "./src/mercury-audit/index.mjs",
  "types": "./src/mercury-audit/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/mercury-audit/index.d.ts",
      "import": "./src/mercury-audit/index.mjs",
      "default": "./src/mercury-audit/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/mercury-audit/",
    "!src/mercury-audit/test_*.mjs",
    "scripts/audit-core/",
    "config/rule-routing.json",
    "docs/SDK-QUICKSTART.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check:upstream": "node scripts/check_upstream_mercury_agent.mjs",
    "dashboard": "node scripts/dashboard_server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "index": "node scripts/rebuild_index.mjs",
    "export:memory": "node scripts/export_memory_bundle.mjs",
    "export:gbrain": "node scripts/export_memory_bundle.mjs --target gbrain",
    "export:agent": "node scripts/export_memory_bundle.mjs --target mercury_agent",
    "import:viewpoint": "node scripts/import_viewpoint.mjs",
    "ingest:doc": "node scripts/ingest_document.mjs",
    "v8:analyze": "node scripts/run_v8_analysis.mjs",
    "sync:skills": "node scripts/sync_skills.mjs",
    "skills:check": "node scripts/check_mercury_skills.mjs",
    "validate": "node scripts/validate_artifacts.mjs",
    "validate:incr": "node scripts/validate_incremental.mjs",
    "audit": "node scripts/audit_packet_runner.mjs",
    "audit:profile": "node scripts/profile_audit_packets.mjs",
    "report": "node scripts/generate_audit_reports.mjs",
    "audit:flow": "node scripts/simulate_memory_flow.mjs",
    "test": "node scripts/test_audit_packets.mjs && node scripts/test_sdk_api.mjs && node scripts/test_governance.mjs && node scripts/test_evidence_chain.mjs && node scripts/test_admission_hardening.mjs && node scripts/test_dashboard_api.mjs && node scripts/test_feedback_lang.mjs && npm run test:fidelity && npm run test:consumer",
    "test:fidelity": "node src/mercury-audit/test_fidelity_modules.mjs && node src/mercury-audit/test_fidelity_routing_integration.mjs",
    "test:sdk": "node scripts/test_sdk_api.mjs",
    "test:governance": "node scripts/test_governance.mjs",
    "demo:memory-hook": "node examples/integration-demo/memory-write-hook.mjs",
    "demo:openclaw": "node examples/integration-demo/openclaw-hook.mjs",
    "demo:starter": "node examples/starter-kit/hello-audit.mjs",
    "cases:build": "node scripts/build_real_cases.mjs",
    "cases:check": "node scripts/check_real_cases.mjs",
    "test:evidence": "node scripts/test_evidence_chain.mjs",
    "demo:a2a": "node examples/a2a/message-task-demo.mjs",
    "benchmark:audit": "node scripts/benchmark_audit_sdk.mjs",
    "benchmark:v2": "node scripts/benchmark_v2_paths.mjs",
    "cycle:status": "node scripts/cycle02_status.mjs",
    "cycle:check": "node scripts/cycle02_check.mjs",
    "dashboard:check": "node scripts/check_dashboard_product.mjs",
    "capture": "node scripts/capture_ai_conversation.mjs",
    "capture:demo": "node scripts/capture_ai_conversation.mjs --file examples/ai-conversation-capture.md",
    "capture:dropzone": "node scripts/capture_ai_conversation.mjs --dropzone 00_inbox/ai-conversations",
    "capture:watch": "node scripts/capture_ai_conversation.mjs --dropzone 00_inbox/ai-conversations --watch",
    "capture:check": "node scripts/check_capture_intake.mjs",
    "release:gate": "powershell -ExecutionPolicy Bypass -File scripts/release_gate.ps1 -CleanKnownGenerated",
    "index:incr": "node scripts/rebuild_index_incremental.mjs",
    "guide:latest": "node scripts/generate_latest_guide.mjs",
    "sync:commit": "node scripts/sync_commit_surfaces.mjs --write",
    "sync:check": "node scripts/sync_commit_surfaces.mjs --check",
    "hooks:install": "node scripts/install_git_hooks.mjs",
    "prepare": "node scripts/install_git_hooks.mjs",
    "test:llm": "node scripts/test_ark_coding_plan.mjs",
    "test:ark": "node scripts/test_ark_coding_plan.mjs",
    "test:skill": "node scripts/run_mercury_skill_test.mjs",
    "goal:validate": "node scripts/goal-validator.mjs",
    "start:llm": "node scripts/start_mercury_provider.mjs",
    "start:ark": "node scripts/start_mercury_provider.mjs",
    "start:ark:legacy": "powershell -ExecutionPolicy Bypass -File scripts/start_mercury_ark.ps1",
    "test:hardening": "node scripts/test_admission_hardening.mjs",
    "test:consumer": "node scripts/test_sdk_consumer.mjs",
    "test:fast": "node scripts/test_audit_packets.mjs && node scripts/test_sdk_api.mjs && node scripts/test_governance.mjs && node scripts/test_evidence_chain.mjs && node scripts/test_admission_hardening.mjs && node scripts/test_dashboard_api.mjs && node scripts/test_feedback_lang.mjs",
    "test:dashboard": "node scripts/test_dashboard_api.mjs",
    "test:feedback-lang": "node scripts/test_feedback_lang.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
